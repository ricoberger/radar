{
  "name": "@ricoberger/radar",
  "version": "0.1.0",
  "description": "Personal AI generated TUI radar built with Ink — everything on your radar in one terminal.",
  "type": "module",
  "bin": {
    "radar": "dist/index.js"
  },
  "files": [
    "dist",
    "swift",
    "scripts"
  ],
  "scripts": {
    "build": "tsc && ./scripts/build-apple-calendar-helper.sh",
    "dev": "npm run build && node dist/index.js --config config.yaml",
    "format": "prettier --write .",
    "postinstall": "./scripts/build-apple-calendar-helper.sh",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "ink": "^7.1.1",
    "react": "^19.0.0",
    "yaml": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.0.0",
    "prettier": "3.9.6",
    "prettier-plugin-organize-imports": "4.3.0",
    "typescript": "^7.0.2"
  },
  "os": [
    "darwin"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ricoberger/radar.git"
  }
}
